PREDICT_API_KEY=your_predict_fun_api_key
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
CRON_SECRET=
ALERT_THRESHOLD=0.015
MIN_SIZE=0
FEE_BUFFER=0
ALERT_COOLDOWN_SEC=300

# 进程内后台监控（Railway / 长进程环境推荐）
# 1 启用，0 禁用。默认启用。
ENABLE_INPROCESS_MONITOR=1
# 后台轮询间隔毫秒。默认 60000 = 1 分钟。
MONITOR_INTERVAL_MS=60000

# Telegram 交互式机器人（long polling）
# 0 关闭。默认开。
ENABLE_TG_BOT=1
# 允许使用机器人命令的额外 chat id（默认只允许 TELEGRAM_CHAT_ID）
# 逗号分隔，例如 TELEGRAM_ALLOWED_CHAT_IDS=12345,67890
TELEGRAM_ALLOWED_CHAT_IDS=

# 可选：覆盖 config/pairs.json
# PAIRS_JSON=[{"name":"52261 $1,000","predictMarketId":"52261","predictSide":"Yes","polymarketTokenId":"...","threshold":0.015}]

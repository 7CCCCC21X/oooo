PREDICT_API_KEY=your_predict_fun_api_key
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Yes 总和提醒没人 /subscribe_yes 时发到的话题（forum topic 的 thread_id）。不配则发到 General。
# 新市场提醒不用这个，由 /subscribe 在目标话题里记录。
TELEGRAM_THREAD_ID=
# 给 /api/test-telegram 加保护；不配则不校验
CRON_SECRET=

# Telegram 交互式机器人（long polling）
# 0 关闭。默认开。
ENABLE_TG_BOT=1
# 允许使用机器人命令的额外 chat id（默认只允许 TELEGRAM_CHAT_ID）
# 逗号分隔，例如 TELEGRAM_ALLOWED_CHAT_IDS=12345,67890
TELEGRAM_ALLOWED_CHAT_IDS=
# 订阅者列表持久化文件（Railway 需挂 Volume 才有持久化，如 /data/subscribers.json）
# 不配的话，订阅者在重新部署后会丢，需重新 /subscribe
SUBSCRIBERS_FILE=
# 额外排除关键词（在内置 baseline "up or down/updown" 之上追加，逗号分隔）
# baseline 始终生效，除非设 DISABLE_NOISE_FILTER=1
EXCLUDE_TITLE_KEYWORDS=
# 设为 1 完全关闭噪音过滤（连 Bitcoin Up or Down 也会显示）
DISABLE_NOISE_FILTER=0

# predict.fun 请求限速（进程级，缓存抓取 / 扫描 / 网页 / bot 共用一个额度）
# 每秒最多发多少个请求；0 = 不限速（只保留 429 暂停）
PREDICT_RATE_LIMIT_RPS=5
# 收到 429 后全部 predict.fun 请求暂停多久（毫秒），接口给了 Retry-After 时取较大者
PREDICT_429_PAUSE_MS=20000
# 单个请求遇到 429，暂停结束后自动重试几次
PREDICT_429_RETRIES=2

# Predict 市场缓存抓取
# /v1/categories 服务端 status 过滤，默认 OPEN（跳过已结算类目，页数大幅减少）。
# 设 none 关闭过滤（全量抓）。接口拒绝该值或返回空时会自动退回全量抓取。
PREDICT_CATEGORY_STATUS=OPEN
# 单页请求遇到 5xx/超时 的重试次数（指数退避），默认 4；429 由上面的限速器处理
PREDICT_FETCH_RETRIES=4
# 最多翻多少页；/status 里"完整性"显示未翻到底时调大
PREDICT_CACHE_MAX_PAGES=500
# 缓存刷新间隔毫秒，默认 600000 = 10 分钟
PREDICT_CACHE_TTL_MS=600000

# 可转换(NegRisk)市场 Yes 买1 总和检查
# 1 开 0 关（默认开）
ENABLE_NEGRISK_MONITOR=1
# 扫描间隔毫秒，默认 300000 = 5 分钟
NEGRISK_CHECK_INTERVAL_MS=300000
# 提醒阈值（¢）：类目里所有结果 Yes 买1 之和 ≥ 阈值就推送。运行时可用 /yes_threshold 改
NEGRISK_ALERT_THRESHOLD=100
# 显示下限（¢）：/yes_check 列出总和 ≥ 这个值的类目，提醒里也会附带"接近阈值"的。运行时可用 /yes_show 改
NEGRISK_DISPLAY_MIN=95
# /yes_check 一次最多列多少个类目
NEGRISK_REPORT_MAX=40
# 同一类目两次提醒的最小间隔秒数
NEGRISK_ALERT_COOLDOWN_SEC=1800
# 阈值/开关持久化文件（不配则放在 SUBSCRIBERS_FILE 同目录的 negrisk-state.json）
NEGRISK_STATE_FILE=
# 每轮最多查询多少个类目（超过的会截掉，看板和 /status 会提示截了多少）
NEGRISK_SCAN_MAX_CATEGORIES=200
# 同时查几个类目 / 一个类目里同时查几个结果的订单簿（限速器会再排队，不必开大）
NEGRISK_SCAN_CATEGORY_CONCURRENCY=1
NEGRISK_SCAN_CONCURRENCY=2
# 第一遍有订单簿没查到的类目，是否补查一次（1 开 0 关）
NEGRISK_RETRY_FAILED=1
# 盘口空判定：Yes 卖一 − 买一 ≥ 这个值（¢）视为盘口空（多半已淘汰或无人做市），不参与"直接卖否"比较
NEGRISK_EMPTY_BOOK_SPREAD=30
# 预过滤：缓存参考价之和低于 (阈值 − 余量) 的类目跳过不查订单簿；设 -1 关闭
NEGRISK_PREFILTER_MARGIN=5
